# Copy to .env and fill in values
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/warehouse_dispatch_planning_allocation_backend
CORS_ORIGINS=["http://localhost:3000"]
# Signs login tokens. Use a long random value for anything beyond a demo, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-value
# A login lasts this many minutes
ACCESS_TOKEN_MINUTES=480
# Demo accounts (admin, viewer and one planner per warehouse) are created on first start with this password
SEED_USERS_ON_STARTUP=true
DEMO_PASSWORD=Dispatch@123
DEBUG=true

# Sales-history CSV used by the forecasting model (~37 MB, not in git). Default: data/quick_commerce_with_events_clean.csv
# DATASET_PATH=data/quick_commerce_with_events_clean.csv

# Build the first recommended dispatch plan at startup (loads data/seed_orders.csv if the orders table is empty)
SEED_ORDERS_ON_STARTUP=true
AUTO_PLAN_ON_STARTUP=true
# Max units per warehouse per day (blank = no cap)
# WAVE_CAPACITY=500

# WMS/ERP. Blank = built-in simulator. Set a base URL to POST approved orders to {WMS_BASE_URL}/dispatch-orders
WMS_BASE_URL=
WMS_API_KEY=
WMS_MAX_RETRIES=3

# --- Integrations: leave the URLs empty to use the built-in simulators. WMS_BASE_URL above also serves live stock. ---
ERP_BASE_URL=
ERP_API_KEY=
# Shared secret the WMS/ERP sends as X-Integration-Key when pushing to /integrations/webhooks/*  (empty = webhooks off)
INTEGRATION_WEBHOOK_KEY=
# Automatic pull every N minutes, 0 = off.
# For a demo that moves by itself set ORDER_SYNC_MINUTES=2 (the built-in simulator sends new orders).
# Keep INVENTORY_SYNC_MINUTES=0 while stock is typed in by hand: the stock simulator would overwrite those counts.
INVENTORY_SYNC_MINUTES=0
ORDER_SYNC_MINUTES=0
SALES_SYNC_MINUTES=0
# Demo only: lets the simulator invent a day of sales and write it into the real history file. Leave false.
SIMULATE_SALES=false

# --- production safety (checked only when APP_ENV=production) ---
APP_ENV=development
# false = the tables come from the Alembic migrations instead of the models
AUTO_CREATE_TABLES=true
# Wrong passwords allowed per account before sign-in pauses
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
# Retrain on the grown sales history every N days (0 = only when asked)
RETRAIN_EVERY_DAYS=0
# Days between ordering a SKU and it arriving, unless set per SKU under Ordering
DEFAULT_LEAD_TIME_DAYS=3

# --- cross-warehouse stock transfers ---
# When one warehouse is short and another can spare the stock, the plan suggests moving it. Nothing moves
# until a planner approves a suggestion. Note: a transfer can only ever be suggested for a SKU that is
# stocked in more than one warehouse.
PROPOSE_TRANSFERS=true
# Transit time between two warehouses, unless a lane is set under Dispatch > Transfers
DEFAULT_TRANSFER_DAYS=1
# Days of its own demand a donor warehouse never gives away, so a transfer cannot cause the next stockout
TRANSFER_KEEP_DAYS=7
# Suggestions smaller than this are not worth a lorry
MIN_TRANSFER_UNITS=5

# --- alerts ---
# Alerts always appear in the app and need nothing configured. The channels below are how they get pushed
# to wherever you already watch things; both stay off until set.
ALERTS_ENABLED=true
# How often the rules are re-checked, in minutes (0 = only when someone presses "Check now")
ALERT_SWEEP_MINUTES=10
# A POST of each new alert as JSON. Slack, Teams, PagerDuty, Opsgenie and most monitoring tools accept this.
ALERT_WEBHOOK_URL=
# Sent as the X-Alert-Key header, if the receiver wants one
ALERT_WEBHOOK_KEY=
# Email instead of, or as well as, the webhook. Needs the SMTP settings below.
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Implicit TLS instead of STARTTLS (usually port 465)
SMTP_USE_SSL=false

# --- forecast accuracy ---
# Re-measure the forecast when a new model is promoted, so the accuracy page stops describing the old one
REFRESH_ACCURACY_AFTER_RETRAIN=true
# The target the accuracy page is judged against (BRD: MAPE <= 15-20%)
ACCURACY_TARGET_MAPE_PCT=20
