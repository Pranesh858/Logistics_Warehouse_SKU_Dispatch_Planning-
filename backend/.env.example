# Copy to .env and fill in values.
#
# The default is a SQLite file, so the planner runs on a fresh machine with no database server to install.
# It creates demo.db beside this folder; delete that file to start the demo data over.
DATABASE_URL=sqlite+aiosqlite:///./demo.db
#
# For real use, run PostgreSQL (docker compose up -d db) and use this line instead. APP_ENV=production insists on it.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/warehouse_dispatch_planning_allocation_backend
CORS_ORIGINS=["http://localhost:3000"]
# Signs login tokens. Use a long random value for anything beyond a demo, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-value
# A login lasts this many minutes
ACCESS_TOKEN_MINUTES=480
# Demo accounts (admin, viewer and one planner per warehouse) are created on first start with this password
SEED_USERS_ON_STARTUP=true
DEMO_PASSWORD=Dispatch@123
DEBUG=true

# Sales-history CSV used by the forecasting model (~37 MB, not in git). Default: data/quick_commerce_with_events_clean.csv
# DATASET_PATH=data/quick_commerce_with_events_clean.csv

# Build the first recommended dispatch plan at startup (loads data/seed_orders.csv if the orders table is empty)
SEED_ORDERS_ON_STARTUP=true
AUTO_PLAN_ON_STARTUP=true
# Max units per warehouse per day (blank = no cap)
# WAVE_CAPACITY=500

# WMS/ERP. Blank = built-in simulator. Set a base URL to POST approved orders to {WMS_BASE_URL}/dispatch-orders
WMS_BASE_URL=
WMS_API_KEY=
WMS_MAX_RETRIES=3

# --- Integrations: leave the URLs empty to use the built-in simulators. WMS_BASE_URL above also serves live stock. ---
ERP_BASE_URL=
ERP_API_KEY=
# Shared secret the WMS/ERP sends as X-Integration-Key when pushing to /integrations/webhooks/*  (empty = webhooks off)
INTEGRATION_WEBHOOK_KEY=
# Automatic pull every N minutes, 0 = off
INVENTORY_SYNC_MINUTES=0
ORDER_SYNC_MINUTES=0
SALES_SYNC_MINUTES=0
# Demo only: lets the simulator invent a day of sales and write it into the real history file. Leave false.
SIMULATE_SALES=false

# --- production safety (checked only when APP_ENV=production) ---
APP_ENV=development
# false = the tables come from the Alembic migrations instead of the models
AUTO_CREATE_TABLES=true
# Wrong passwords allowed per account before sign-in pauses
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
# Retrain on the grown sales history every N days (0 = only when asked)
RETRAIN_EVERY_DAYS=0
# Days between ordering a SKU and it arriving, unless set per SKU under Ordering
DEFAULT_LEAD_TIME_DAYS=3
